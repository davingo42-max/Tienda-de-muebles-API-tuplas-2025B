def buscar_cliente(codigo):
    for i, cliente in enumerate(base_datos_clientes):
        if cliente[0] == codigo:
            return cliente, i
    return None, -1

def buscar_factura(cliente_data, codigo):
    facturas = cliente_data[3]
    for i, factura in enumerate(facturas):
        if factura[0] == codigo:
            return factura, i
    return None, -1

def generar_codigo(prefijo, lista):
    if not lista:
        numero = 1
    else:
        ultimo_codigo = lista[-1][0]
        try:
            numero = int(ultimo_codigo[len(prefijo):]) + 1
        except ValueError:
            numero = len(lista) + 1
    return f"{prefijo}{numero:03d}"

def crear_cliente():
    print("\n--- CREAR CLIENTE ---")
    nuevo_codigo = generar_codigo("C", base_datos_clientes)
    nombre = input("Nombre completo: ")
    email = input("Email: ")
    
    if not nombre or not email:
        print("Error: Nombre y email son obligatorios.")
        return

    nuevo_cliente = (nuevo_codigo, nombre, email, []) 
    base_datos_clientes.append(nuevo_cliente)
    print(f"Cliente {nuevo_codigo} creado.")

def listar_clientes():
    print("\n--- LISTA DE CLIENTES ---")
    if not base_datos_clientes:
        print("No hay clientes registrados.")
        return
    
    for codigo, nombre, email, facturas in base_datos_clientes:
        print(f"[{codigo}] {nombre} | Email: {email} | Facturas: {len(facturas)}")

def actualizar_cliente():
    print("\n--- ACTUALIZAR EMAIL ---")
    codigo = input("Código de cliente a actualizar: ").upper()
    cliente, indice = buscar_cliente(codigo)

    if cliente:
        print(f"Cliente: {cliente[1]}")
        nuevo_email = input("Nuevo Email: ")
        if not nuevo_email:
            print("Error: Email no puede estar vacío.")
            return

        cliente_actualizado = (cliente[0], cliente[1], nuevo_email, cliente[3])
        base_datos_clientes[indice] = cliente_actualizado
        print(f"Email de {cliente[1]} actualizado.")
    else:
