    facturas_cliente = cliente_data[3]
    nuevo_codigo = generar_codigo("F", facturas_cliente)
    
    fecha = input("Fecha (YYYY-MM-DD): ")
    try:
        monto = float(input("Monto Total: "))
        cantidad_items = int(input("Cantidad de Ítems: "))
    except ValueError:
        print("Error en formato de monto o cantidad.")
        return
    
    if monto <= 0 or cantidad_items <= 0:
        print("Error: Monto y cantidad deben ser positivos.")
        return

    nueva_factura = (nuevo_codigo, fecha, monto, cantidad_items)
    facturas_cliente.append(nueva_factura)
    print(f"Factura {nuevo_codigo} creada y asociada a {cliente_data[1]}.")

