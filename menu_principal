    if not facturas_cliente:
        print(f"El cliente {cliente_data[1]} no tiene facturas para eliminar.")
        return

    listar_facturas(cliente_data)
    codigo_factura = input("Código de factura a eliminar: ").upper()
    
    factura, indice_factura = buscar_factura(cliente_data, codigo_factura)

    if factura:
        confirma = input(f"Eliminar factura {codigo_factura}? (s/n): ").lower()
        if confirma == 's':
            facturas_cliente.pop(indice_factura)
            print(f"Factura {codigo_factura} eliminada.")
        else:
            print("Eliminación cancelada.")
    else:
        print(f"Factura {codigo_factura} no encontrada.")

