def eliminar_cliente():
    print("\n--- ELIMINAR CLIENTE ---")
    codigo = input("Código de cliente a eliminar: ").upper()
    cliente, indice = buscar_cliente(codigo)

    if cliente:
        confirma = input(f"Eliminar a {cliente[1]}? (s/n): ").lower()
        if confirma == 's':
            base_datos_clientes.pop(indice)
            print(f"Cliente {cliente[1]} eliminado.")
        else:
            print("Eliminación cancelada.")
    else:
        print(f"Cliente {codigo} no encontrado.")

def crear_factura(cliente_data, indice_cliente):
